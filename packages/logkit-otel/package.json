{
  "name": "@buchanan-solutions/logkit-otel",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "OTLP/HTTP log transport for @buchanan-solutions/logkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchanan-solutions/logkit",
    "directory": "packages/logkit-otel"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@buchanan-solutions/logkit": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": { "optional": true }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^25.9.6",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
