{
  "name": "@buchanan-solutions/logkit-mcp",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Stdio MCP for log debug HTTP (LOG_DEBUG_URL)",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchanan-solutions/ts-logkit",
    "directory": "packages/logkit-mcp"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "mcp/dist"
  ],
  "bin": {
    "logkit-mcp": "./mcp/dist/stdio.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm exec esbuild src/stdio.ts --bundle --platform=node --format=esm --outfile=mcp/dist/stdio.mjs --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk",
    "lint": "biome check .",
    "test": "vitest run",
    "start:mcp": "node mcp/dist/stdio.mjs"
  },
  "dependencies": {
    "@buchanan-solutions/logkit": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
