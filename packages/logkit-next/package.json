{
  "name": "@buchanan-solutions/logkit-next",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Next.js server and client logkit wiring",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchanan-solutions/ts-logkit",
    "directory": "packages/logkit-next"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@buchanan-solutions/logkit": "workspace:*",
    "@buchanan-solutions/logkit-otel": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  }
}
