{
  "name": "@buchanan-solutions/logkit",
  "version": "0.5.0",
  "private": false,
  "description": "Composable logging: factory, registry, ring debug contract, and stdlib-style hierarchy",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchanan-solutions/logkit",
    "directory": "packages/logkit"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "dependencies": {
    "commander": "^14.0.2",
    "zod": "^4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ring": {
      "types": "./dist/ring/index.d.ts",
      "import": "./dist/ring/index.js",
      "require": "./dist/ring/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "require": "./dist/client/index.cjs"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.cjs"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "import": "./dist/stores/index.js",
      "require": "./dist/stores/index.cjs"
    },
    "./stores/server": {
      "types": "./dist/stores/server.d.ts",
      "import": "./dist/stores/server.js",
      "require": "./dist/stores/server.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.9.6",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^1 || ^2 || ^3"
  }
}
