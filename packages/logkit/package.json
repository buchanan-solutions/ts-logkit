{
  "name": "@buchanan-solutions/logkit",
  "version": "0.5.0",
  "private": false,
  "description": "Composable logging: factory, registry, ring debug contract, and stdlib-style hierarchy",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchanan-solutions/ts-logkit",
    "directory": "packages/logkit"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && esbuild src/cli/cli.ts --bundle --platform=node --format=cjs --outfile=dist/log.cjs --banner:js=\"#!/usr/bin/env node\"",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "zod": "^4.1.12"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ring": {
      "import": {
        "types": "./dist/ring/index.d.ts",
        "default": "./dist/ring/index.js"
      },
      "require": {
        "types": "./dist/ring/index.d.cts",
        "default": "./dist/ring/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./registry": {
      "import": {
        "types": "./dist/registry/index.d.ts",
        "default": "./dist/registry/index.js"
      },
      "require": {
        "types": "./dist/registry/index.d.cts",
        "default": "./dist/registry/index.cjs"
      }
    },
    "./stores": {
      "import": {
        "types": "./dist/stores/index.d.ts",
        "default": "./dist/stores/index.js"
      },
      "require": {
        "types": "./dist/stores/index.d.cts",
        "default": "./dist/stores/index.cjs"
      }
    },
    "./stores/server": {
      "import": {
        "types": "./dist/stores/server.d.ts",
        "default": "./dist/stores/server.js"
      },
      "require": {
        "types": "./dist/stores/server.d.cts",
        "default": "./dist/stores/server.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./testing/vitest": {
      "import": {
        "types": "./dist/testing/vitest/index.d.ts",
        "default": "./dist/testing/vitest/index.js"
      },
      "require": {
        "types": "./dist/testing/vitest/index.d.cts",
        "default": "./dist/testing/vitest/index.cjs"
      }
    },
    "./ring/node": {
      "import": {
        "types": "./dist/ring/node/index.d.ts",
        "default": "./dist/ring/node/index.js"
      },
      "require": {
        "types": "./dist/ring/node/index.d.cts",
        "default": "./dist/ring/node/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^1 || ^2 || ^3"
  },
  "bin": {
    "log": "./dist/log.cjs"
  }
}
